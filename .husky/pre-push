#!/usr/bin/env sh

ROOT="$(git rev-parse --show-toplevel)"

if [ -z "${NPM_TOKEN:-}" ] && [ -f "$ROOT/.env" ]; then
  NPM_TOKEN="$(grep -E '^NPM_TOKEN=' "$ROOT/.env" | tail -n1 | cut -d '=' -f2-)"
  export NPM_TOKEN
fi

if [ -z "${NPM_TOKEN:-}" ]; then
  echo "pre-push: NPM_TOKEN is not set."
  echo "  Add 'NPM_TOKEN=<azure-devops-pat>' to $ROOT/.env (git-ignored)"
  exit 1
fi

# Pre-create the bind-mount output dirs as the current user, otherwise the Docker
# daemon creates them as root and the container's node user cannot write reports.
mkdir -p "$ROOT/coverage" "$ROOT/test-results"

docker compose -f docker-compose.test.yml run --rm --build --remove-orphans test
exit $?
